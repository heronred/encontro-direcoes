rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidEvent(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.location is string && data.location.size() <= 300 &&
             data.dateTime is string &&
             (data.speaker == null || (data.speaker is string && data.speaker.size() <= 200));
    }

    // Events: Read for all, cleanup allowed temporarily
    match /marista_sp_events/{eventId} {
      allow read, list: if true;
      allow create, delete: if true; // Temporary for cleanup
      allow update: if false;
    }
  }
}
